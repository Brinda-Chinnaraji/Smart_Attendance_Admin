<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- MAIN SCREEN -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg">

        <!-- APPBAR -->
        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/card_dark"
            android:layout_marginTop="20dp">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/topAppBar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/card_dark"
                app:title="Smart Attendance System"
                app:titleCentered="true"
                app:titleTextColor="@color/cardBg"
                app:navigationIconTint="@color/cardBg"/>
        </com.google.android.material.appbar.AppBarLayout>

        <!-- SCROLL CONTENT -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingTop="12dp">

                <!-- WELCOME CARD -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:background="@drawable/btn_green"
                    android:layout_marginBottom="20dp"
                    android:clipToOutline="true">

                    <TextView
                        android:id="@+id/tvWelcome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Welcome, Professor"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/white"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#40FFFFFF"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Select your course:"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/white"
                        android:layout_marginBottom="8dp"/>

                    <Spinner
                        android:id="@+id/spinnerCourses"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@drawable/btn_green"
                        android:padding="12dp"
                        android:spinnerMode="dropdown"/>
                </LinearLayout>

                <!-- SEMESTER CARD -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:background="@drawable/btn_green"
                    android:layout_marginBottom="20dp"
                    android:clipToOutline="true">

                    <TextView
                        android:id="@+id/tvSemester"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Semester:"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/white"/>

                    <TextView
                        android:id="@+id/tvSchedule"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Schedule:"
                        android:textSize="16sp"
                        android:layout_marginTop="8dp"
                        android:textColor="@android:color/white"/>
                </LinearLayout>

                <!-- ATTENDANCE CONTROLS CARD -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="24dp"
                    android:background="@drawable/btn_green"
                    android:layout_marginBottom="20dp"
                    android:clipToOutline="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Attendance Controls"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/white"
                        android:layout_marginBottom="12dp"/>

                    <com.airbnb.lottie.LottieAnimationView
                        android:id="@+id/animationBluetooth"
                        android:layout_width="180dp"
                        android:layout_height="180dp"
                        android:layout_marginBottom="16dp"
                        android:visibility="gone"
                        app:lottie_rawRes="@raw/bluetooth_anim"
                        app:lottie_autoPlay="false"
                        app:lottie_loop="true"/>

                    <Button
                        android:id="@+id/btnStartAttendance"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Start Attendance"
                        android:textAllCaps="false"
                        android:background="@drawable/btn_white_rounded"
                        android:textColor="@android:color/black"
                        android:layout_marginBottom="12dp"/>

                    <Button
                        android:id="@+id/btnStopAttendance"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Stop Attendance"
                        android:textAllCaps="false"
                        android:background="@drawable/btn_white_rounded"
                        android:textColor="@android:color/black"/>

                    <TextView
                        android:id="@+id/tvDebugInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        android:layout_marginTop="12dp"
                        android:textStyle="italic"
                        android:text="Debug info will appear here"
                        android:gravity="center_horizontal"
                        android:visibility="gone"/>
                </LinearLayout>

                <!-- ADMIN CARD -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/btn_green"
                    android:layout_marginBottom="20dp"
                    android:clipToOutline="true">

                    <Button
                        android:id="@+id/btnManualfallback"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Manual Fallback"
                        android:textAllCaps="false"
                        android:background="@drawable/btn_white_rounded"
                        android:textColor="@android:color/black"/>
                </LinearLayout>

                <!-- HISTORY BUTTON -->
                <Button
                    android:id="@+id/btnAttendanceHistory"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Attendance History"
                    android:textAllCaps="false"
                    android:background="@drawable/btn_white_rounded"
                    android:textColor="@android:color/black"
                    android:layout_marginBottom="20dp"/>
            </LinearLayout>
        </ScrollView>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- DRAWER -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:menu="@menu/menu_drawer_main"
        android:background="@color/card_dark"/>
</androidx.drawerlayout.widget.DrawerLayout>
