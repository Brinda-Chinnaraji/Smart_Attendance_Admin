<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Page Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Course"
            android:textStyle="bold"
            android:textSize="24sp"
            android:textColor="@android:color/white"
            android:layout_gravity="center"
            android:layout_marginBottom="16dp"/>

        <!-- Course Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/btn_green"
            android:clipToOutline="true"
            android:layout_marginBottom="16dp">

            <!-- Course Name -->
            <EditText
                android:id="@+id/etCourseName"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Course Name (e.g., SSDI)"
                android:background="@drawable/btn_green"
                android:padding="12dp"
                android:textColor="@android:color/white"
                android:textColorHint="@android:color/white"
                android:layout_marginBottom="12dp"/>

            <!-- Short Code -->
            <EditText
                android:id="@+id/etShortCode"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Short Code (ITCS1234)"
                android:background="@drawable/btn_green"
                android:padding="12dp"
                android:textColor="@android:color/white"
                android:textColorHint="@android:color/white"
                android:layout_marginBottom="12dp"/>

            <!-- Buttons Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <Button
                    android:id="@+id/btnPickProfessor"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Pick Professor"
                    android:background="@drawable/btn_white_rounded"
                    android:textAllCaps="false"
                    android:textColor="@android:color/black"/>

                <Space
                    android:layout_width="12dp"
                    android:layout_height="1dp"/>

                <Button
                    android:id="@+id/btnQuickNewProfessor"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="New Professor"
                    android:background="@drawable/btn_white_rounded"
                    android:textAllCaps="false"
                    android:textColor="@android:color/black"/>
            </LinearLayout>

            <!-- Picked Professor Display -->
            <TextView
                android:id="@+id/tvPickedProfessor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Professor: none"
                android:textColor="@android:color/white"
                android:layout_marginBottom="16dp"/>

            <!-- Schedule Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Initial Schedule"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <!-- Day Spinner -->
            <Spinner
                android:id="@+id/spinnerDay"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/btn_green"
                android:padding="12dp"
                android:spinnerMode="dropdown"
                android:backgroundTint="@null"
                android:popupBackground="@drawable/spinner_dark_green"
                android:layout_marginBottom="12dp"/>

            <!-- Time Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/etStartTime"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:hint="Start Time"
                    android:background="@drawable/btn_green"
                    android:padding="12dp"
                    android:textColor="@android:color/white"
                    android:gravity="center_vertical"
                    android:drawableEnd="@android:drawable/ic_menu_my_calendar"
                    android:layout_marginEnd="6dp"/>

                <TextView
                    android:id="@+id/etEndTime"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:hint="End Time"
                    android:background="@drawable/btn_green"
                    android:padding="12dp"
                    android:textColor="@android:color/white"
                    android:gravity="center_vertical"
                    android:drawableEnd="@android:drawable/ic_menu_my_calendar"
                    android:layout_marginStart="6dp"/>
            </LinearLayout>

            <!-- Semester and Students Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <Button
                    android:id="@+id/btnPickSemester"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Pick Semester"
                    android:textAllCaps="false"
                    android:background="@drawable/btn_white_rounded"
                    android:textColor="@android:color/black"/>

                <Space
                    android:layout_width="12dp"
                    android:layout_height="1dp"/>

                <Button
                    android:id="@+id/btnPickStudents"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Pick Students"
                    android:background="@drawable/btn_white_rounded"
                    android:textAllCaps="false"
                    android:textColor="@android:color/black"/>
            </LinearLayout>

            <!-- Picked Semester and Students -->
            <TextView
                android:id="@+id/tvPickedSemester"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Semester: none"
                android:textColor="@android:color/white"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvPickedStudents"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Students: none"
                android:textColor="@android:color/white"
                android:layout_marginBottom="12dp"/>
        </LinearLayout>

        <!-- Save Button -->
        <Button
            android:id="@+id/btnSaveCourse"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Save Course"
            android:textAllCaps="false"
            android:background="@drawable/btn_white_rounded"
            android:textColor="@android:color/black"/>
    </LinearLayout>
</ScrollView>
