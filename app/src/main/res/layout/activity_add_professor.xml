<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F5F7FA" android:padding="16dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Professor"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="#111827"
            android:layout_marginBottom="12dp"/>

        <!-- Professor card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#FFFFFF"
            android:elevation="2dp"
            android:layout_marginBottom="16dp">

            <EditText
                android:id="@+id/etName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Name"
                android:background="@android:drawable/edit_text"
                android:padding="10dp"/>

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Email"
                android:inputType="textEmailAddress"
                android:layout_marginTop="10dp"
                android:background="@android:drawable/edit_text"
                android:padding="10dp"/>

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Password"
                android:inputType="textPassword"
                android:layout_marginTop="10dp"
                android:background="@android:drawable/edit_text"
                android:padding="10dp"/>

            <EditText
                android:id="@+id/etDepartment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Department"
                android:layout_marginTop="10dp"
                android:background="@android:drawable/edit_text"
                android:padding="10dp"/>

            <EditText
                android:id="@+id/etProfessorCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Professor Code (e.g., PROF-JS001)"
                android:layout_marginTop="10dp"
                android:background="@android:drawable/edit_text"
                android:padding="10dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <Button
                    android:id="@+id/btnPickExistingCourses"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Assign Existing"
                    android:backgroundTint="@color/teal_700"
                    android:textColor="@android:color/white"/>

                <Space
                    android:layout_width="12dp"
                    android:layout_height="1dp" />

                <Button
                    android:id="@+id/btnQuickNewCourse"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="New Course + Link"
                    android:backgroundTint="@color/teal_200"
                    android:textColor="#073B3A"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvPickedCourses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Selected: none"
                android:textColor="#6B7280"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

        <!-- Save -->
        <Button
            android:id="@+id/btnSaveProfessor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Professor"
            android:backgroundTint="@color/teal_700"
            android:textColor="@android:color/white"/>
    </LinearLayout>
</ScrollView>