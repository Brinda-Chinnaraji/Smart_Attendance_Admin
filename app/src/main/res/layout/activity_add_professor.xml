<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="12dp">

        <!-- PAGE TITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Professor"
            android:textStyle="bold"
            android:textSize="26sp"
            android:textColor="@android:color/white"
            android:layout_gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- PROFESSOR CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="520dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/btn_green"
            android:clipToOutline="true"
            android:orientation="vertical"
            android:padding="24dp">

            <EditText
                android:id="@+id/etName"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/btn_green"
                android:hint="Name"
                android:padding="12dp"
                android:textColor="@android:color/white"
                android:textColorHint="@android:color/white" />

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/btn_green"
                android:hint="Email"
                android:inputType="textEmailAddress"
                android:padding="12dp"
                android:textColor="@android:color/white"
                android:textColorHint="@android:color/white" />

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/btn_green"
                android:hint="Password"
                android:inputType="textPassword"
                android:padding="12dp"
                android:textColor="@android:color/white"
                android:textColorHint="@android:color/white" />

            <EditText
                android:id="@+id/etDepartment"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/btn_green"
                android:hint="Department"
                android:padding="12dp"
                android:textColor="@android:color/white"
                android:textColorHint="@android:color/white" />

            <EditText
                android:id="@+id/etProfessorCode"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/btn_green"
                android:hint="Professor Code (e.g., PROF-JS001)"
                android:padding="12dp"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textColorHint="@android:color/white" />

            <!-- BUTTONS: Assign / New Course -->
                <Button
                    android:id="@+id/btnPickExistingCourses"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_weight="2"
                    android:background="@drawable/btn_white_rounded"
                    android:text="Assign Existing"
                    android:textAllCaps="false"
                    android:textColor="@android:color/black"/>

            <View
                android:layout_width="20dp"
            android:layout_height="17dp"/>
                <Button
                    android:id="@+id/btnQuickNewCourse"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_weight="2"
                    android:background="@drawable/btn_white_rounded"
                    android:text="New Course"
                    android:textAllCaps="false"
                    android:textColor="@android:color/black" />


            <TextView
                android:id="@+id/tvPickedCourses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Selected: none"
                android:textColor="@android:color/white" />
        </LinearLayout>

        <!-- SAVE BUTTON -->
        <Button
            android:id="@+id/btnSaveProfessor"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Save Professor"
            android:background="@drawable/btn_white_rounded"
            android:textColor="@android:color/black"
            android:textAllCaps="false"
            android:layout_marginTop="16dp"/>
    </LinearLayout>
</ScrollView>
